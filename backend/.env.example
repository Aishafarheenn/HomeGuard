# Copy to .env and fill in values. Never commit .env.

# Environment: development | production | test
ENV=development

# Required in production. Use a long random string (e.g. openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production

# JWT algorithm (default HS256)
ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL
# SQLite (default):
# DATABASE_URL=sqlite:///./homeguard.db
# PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/homeguard

# CORS: comma-separated list of allowed origins. Leave empty in production to deny all until set.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
